{
  "name": "laplateforme-starter",
  "version": "2.0.0",
  "description": "Scaffold a production-ready Node.js project: security gates, CI/CD, tests and containers that work from the first commit",
  "bin": {
    "laplateforme-starter": "./bin/cli.js",
    "laplateforme": "./bin/cli.js",
    "create-laplateforme": "./bin/cli.js"
  },
  "files": [
    "bin",
    "lib",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint \"bin/**/*.js\" \"lib/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"{bin,lib,scripts,tests}/**/*.js\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{bin,lib,scripts,tests}/**/*.js\" \"*.{json,md}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "smoke": "node scripts/smoke.js",
    "smoke:quick": "node scripts/smoke.js --quick",
    "scan:secrets": "gitleaks detect --verbose --redact",
    "scan:sast": "semgrep scan --config=\"p/owasp-top-ten\" bin lib"
  },
  "keywords": [
    "scaffolding",
    "generator",
    "starter",
    "devsecops",
    "ci-cd",
    "boilerplate",
    "express",
    "hono",
    "nestjs",
    "nextjs",
    "react",
    "vue",
    "prisma",
    "playwright",
    "docker"
  ],
  "author": "Konstantine Garozashvili",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konstantine/ci-cd-kube.git"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "js-yaml": "^5.4.1",
    "prettier": "^3.2.5"
  }
}
