{
  "name": "laplateforme-cli",
  "version": "1.0.0",
  "description": "La Plateforme - Enterprise DevSecOps Scaffolding Engine & Cloud-Native Starter Framework",
  "main": "src/server.js",
  "bin": {
    "laplateforme": "./bin/cli.js",
    "create-laplateforme": "./bin/cli.js",
    "laplateforme-cli": "./bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "tests",
    ".eslintrc.json",
    ".prettierrc",
    ".gitleaks.toml",
    ".semgrepignore",
    ".dockerignore",
    "jest.config.js",
    "playwright.config.js",
    "Dockerfile",
    ".env.example",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\" \"bin/**/*.js\" \"templates/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" \"tests/**/*.js\" \"bin/**/*.js\" \"templates/**/*.js\" --fix",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.js\"",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"*.js\"",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "init": "node bin/cli.js",
    "scan:secrets": "gitleaks detect --verbose",
    "scan:sast": "semgrep scan --config=\"p/owasp-top-ten\" src"
  },
  "keywords": [
    "laplateforme",
    "devsecops",
    "scaffolding",
    "ci-cd",
    "express",
    "hono",
    "nestjs",
    "nextjs",
    "gitleaks",
    "trivy",
    "owasp",
    "playwright",
    "jest"
  ],
  "author": "Konstantine Garozashvili",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "supertest": "^7.0.0"
  }
}
