# Enforces Conventional Commits without pulling in a linter dependency.
# Example: feat(api): add pagination to /api/users
commit_msg=$(head -n1 "$1")

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,}'

if ! printf '%s' "$commit_msg" | grep -Eq "$pattern"; then
  echo "❌ Commit message does not follow Conventional Commits."
  echo "   Got:      $commit_msg"
  echo "   Expected: <type>(<optional scope>): <description>"
  echo "   Types:    feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  exit 1
fi
