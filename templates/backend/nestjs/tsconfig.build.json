{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // TypeScript 6 requires rootDir to be explicit once tests are excluded,
    // otherwise the inferred common source directory changes the dist layout.
    "rootDir": "./src"
  },
  "exclude": ["node_modules", "dist", "tests", "**/*.spec.ts", "**/*.test.ts"]
}
